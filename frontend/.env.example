# Frontend Environment Configuration
# Copy to .env.local for local development or use for build process
# These variables must be prefixed with REACT_APP_ to be accessible in the frontend

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Environment
REACT_APP_ENV=development

# Feature Flags
REACT_APP_FEATURE_FACE_RECOGNITION=true
REACT_APP_FEATURE_PDF_EXPORT=true
REACT_APP_FEATURE_EXCEL_EXPORT=true
REACT_APP_FEATURE_NOTIFICATIONS=true

# Logging
REACT_APP_LOGGING_ENABLED=false
REACT_APP_LOG_LEVEL=info

# Production Examples (Uncomment and update for production)
# REACT_APP_API_BASE_URL=https://api.yourdomain.com/api
# REACT_APP_ENV=production
# REACT_APP_LOGGING_ENABLED=false
