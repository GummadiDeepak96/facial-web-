# Example environment variables for backend
# Copy to .env and update values (DO NOT commit real credentials to git)

# Main app DB (employee_management)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD= 
DB_NAME=employee_management

# PHP realtime DB (XAMPP)
PHP_DB_HOST=localhost
PHP_DB_USER=node_reader
PHP_DB_PASSWORD=StrongPassword123!
PHP_DB_NAME=realtime

# Server
PORT=5000

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Email (example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=app-password
